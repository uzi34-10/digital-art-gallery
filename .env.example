# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=production

# ==========================================
# Database Connection (MongoDB Atlas)
# ==========================================
MONGO_URI=mongodb://user:pass@host:27017/dbname?ssl=true&replicaSet=atlas-shard-0&authSource=admin&retryWrites=true&w=majority

# ==========================================
# Security & JWT Secrets
# ==========================================
# Generate a strong 256-bit random string for production
JWT_SECRET=replace_with_a_secure_random_production_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Allowed CORS origins (comma-separated, or * for public API)
CORS_ORIGIN=*

# Secret required if an account attempts to register with role 'admin' directly
ADMIN_REGISTRATION_SECRET=your_admin_onboarding_secret_passphrase
