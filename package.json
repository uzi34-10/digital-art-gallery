{
  "name": "digital-art-gallery-management-system",
  "version": "1.0.0",
  "description": "Production-ready Backend REST API for Digital Art Gallery Management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs gallery-backend",
    "docker:build": "docker build -t gallery-backend .",
    "docker:run": "docker run -p 5000:5000 --env-file .env gallery-backend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "html-to-docx": "^1.8.0",
    "jsonwebtoken": "^9.0.0",
    "marked": "^18.0.5",
    "mongoose": "^7.3.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
